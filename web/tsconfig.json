{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "/auth/static/site.js": [
        "./frame/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "frame",
    "widgets"
  ]
}
