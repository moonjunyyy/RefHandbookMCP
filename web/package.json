{
  "name": "site-pages",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The site's pages (src/) and the frame every page imports at run time (frame/ → /auth/static/site.js): front ends over the services' JSON APIs (docs/site.md, docs/frame.md).",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:frame && tsc --noEmit && vite build && vite build -c vite.widgets.config.ts && npm run build:fonts",
    "build:frame": "vite build -c vite.frame.config.ts && tsc -p tsconfig.frame.json",
    "check": "tsc --noEmit && tsc -p tsconfig.frame.json --noEmit false --emitDeclarationOnly --outDir /tmp/frame-types",
    "build:widgets": "vite build -c vite.widgets.config.ts",
    "build:fonts": "node scripts/fonts.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/hahmlet": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource-variable/noto-serif-kr": "5.3.1",
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/black-han-sans": "5.3.0",
    "@fontsource/do-hyeon": "5.3.0",
    "@fontsource/gaegu": "5.3.0",
    "@fontsource/gothic-a1": "5.3.0",
    "@fontsource/gowun-batang": "5.3.0",
    "@fontsource/gowun-dodum": "5.3.0",
    "@fontsource/hi-melody": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/jua": "5.3.0",
    "@fontsource/nanum-gothic": "5.3.0",
    "@fontsource/nanum-gothic-coding": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/nanum-pen-script": "5.3.0",
    "@fontsource/orbit": "5.3.0",
    "@fontsource/song-myung": "5.3.1",
    "@fontsource/sunflower": "5.3.1",
    "@sun-typeface/suit": "2.0.5",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "d2coding": "1.3.2",
    "pretendard": "1.3.9",
    "spoqa-han-sans": "3.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wanted-sans": "1.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "katex": "^0.19.1",
    "markdown-it": "^14.1.0"
  }
}
