# /etc/@@unit:handbook@@/handbook.env — local overrides only; read by @@unit:handbook@@ and @@unit:runner@@.
# Every other setting comes from the site's facts, in the units (deploy/templates/handbook.service).
# Made once by the installer; never overwritten.
#
# Only members of this POSIX group (resolved through NSS) may use the handbook:
#RHB_REQUIRE_GROUP=research
# Token lifetimes in seconds (a refresh re-checks the account; the session is absolute):
#RHB_ACCESS_TTL=3600
#RHB_REFRESH_TTL=2592000
#RHB_SESSION_TTL=7776000
# Agents on a custom model server: only https to public addresses, unless the host (or host:port) is
# listed here (a model server on the LAN, a local Ollama). Read by both units: the page checks a key
# with it, the runner every call.
#RHB_AGENT_PRIVATE_ENDPOINTS=gpu.lan:8000,127.0.0.1:11434
# Where users may pick directories to mount into their sandbox, comma-separated FROM[=NAME][:ro]: a policy
# names a directory of theirs inside a FROM by its path ({user} and {uid} name the user; NAME, if given,
# is a short way to write it; :ro never read-write). Unset: /home/{user}. @@name@@-mounts.service mounts
# what the policies pick (idmapped: the user's files stay the user's) when one is saved and every minute;
# `refhandbook mounts --data-dir … --service-user … --stage … --check` shows the plan and what it refuses.
#RHB_SANDBOX_MOUNTS=/data/{user},/home/{user},/srv/corpora=corpora:ro
