# /etc/@@unit:vault@@/vault.env — local overrides only; read by @@unit:vault@@ and @@name@@-vault-mounts.
# Every other setting comes from the site's facts, in the unit (deploy/templates/vault.service).
# Made once by the installer; never overwritten.
#
# Where people may register a vault from, comma-separated FROM[=NAME][:ro] (the syntax of the
# handbook's RHB_SANDBOX_MOUNTS): a vault is a directory of theirs inside a FROM ({user} and {uid} name
# the user; NAME, if given, is a short way to write it). Unset: /data/{user}=storage.
# @@name@@-vault-mounts.service stages what is registered (idmapped: the files stay the person's) when
# one is registered and every minute; `refhandbook mounts --picks vault --roots-env PORTAL_VAULT_ROOTS
# --data-dir /var/lib/@@unit:vault@@ --service-user @@user:vault@@ --stage /run/@@name@@-vault-mounts --check`
# shows the plan and what it refuses.
#PORTAL_VAULT_ROOTS=/data/{user}=storage
