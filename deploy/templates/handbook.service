# @@generated@@
# The reference handbook: its MCP server, behind the site sign-in. Every setting comes from the site's
# facts; /etc/@@unit:handbook@@/handbook.env holds local overrides only. It may not create namespaces:
# @@unit:runner@@ runs the sandboxed jobs.
[Unit]
Description=@@name@@ reference handbook (MCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@user:handbook@@
Group=@@user:handbook@@
# 0755 and root's: the agent key pair lives here (the private half 0400, the runner's credential)
ConfigurationDirectory=@@unit:handbook@@
ConfigurationDirectoryMode=0755
StateDirectory=@@unit:handbook@@
StateDirectoryMode=0700
Environment=RHB_PUBLIC_URL=https://@@domain@@
Environment=RHB_PORT=@@port:handbook@@
Environment=RHB_SSO_PUBLIC_KEY_FILE=@@sso_public_key@@
Environment=RHB_SSO_ISSUER=@@issuer@@
Environment=RHB_SSO_AUDIENCE=@@handbook_audience@@
Environment=RHB_LOGIN_URL=@@signin@@/login
EnvironmentFile=-/etc/@@unit:handbook@@/handbook.env
WorkingDirectory=/var/lib/@@unit:handbook@@
ExecStart=@@code@@/.venv/bin/refhandbook serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
