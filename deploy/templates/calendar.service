# @@generated@@
# The calendars (portal/calendar.py): one per person and per project, events, the ICS feeds. Its own
# user, with no keytab and no secret: it trusts the SSO's tokens, checked with the public key, and
# asks NSS who is in which project.
[Unit]
# its port is @@unit:calendar@@.socket's (systemd hands the socket over as fd 3), so a restart refuses no one
Requires=@@unit:calendar@@.socket
After=@@unit:calendar@@.socket
Description=@@name@@ calendars
After=network-online.target nss-user-lookup.target
Wants=network-online.target

[Service]
User=@@unit:calendar@@
Group=@@unit:calendar@@
StateDirectory=@@unit:calendar@@
StateDirectoryMode=0700
Environment=PORTAL_SITE=@@site_file@@
WorkingDirectory=@@code@@
ExecStart=@@code@@/.venv/bin/uvicorn portal.calendar:create_app --factory \
          --fd 3 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
