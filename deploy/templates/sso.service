# @@generated@@
# The site sign-in (nginx auth_request). Its own user, with only the HTTP keytab and the token
# signing key: it never sees the portal's kadmin keytab.
[Unit]
Description=@@name@@ site sign-in
After=network-online.target
Wants=network-online.target

[Service]
User=@@unit:sso@@
Group=@@unit:sso@@
ConfigurationDirectory=@@unit:sso@@
# 0755: backends read sso-public.pem here; the secrets in it are 0640/0400
ConfigurationDirectoryMode=0755
LogsDirectory=@@unit:sso@@
LogsDirectoryMode=0700
Environment=PORTAL_SITE=@@site_file@@
EnvironmentFile=-/etc/@@unit:sso@@/sso.env
WorkingDirectory=@@code@@
# one worker: the sign-in throttle and the WebDAV Basic cache are in memory
ExecStart=@@code@@/.venv/bin/uvicorn portal.sso:create_app --factory \
          --host 127.0.0.1 --port @@port:sso@@ --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
