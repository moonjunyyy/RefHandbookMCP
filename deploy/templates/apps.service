# @@generated@@
# The apps' storage (portal/apps.py): each user's JSON values, per app the site hosts. Its own user,
# with no keytab and no secret: it trusts the SSO's tokens, checked with the public key.
[Unit]
Description=@@name@@ apps storage
After=network-online.target
Wants=network-online.target

[Service]
User=@@unit:apps@@
Group=@@unit:apps@@
StateDirectory=@@unit:apps@@
StateDirectoryMode=0700
Environment=PORTAL_SITE=@@site_file@@
WorkingDirectory=@@code@@
ExecStart=@@code@@/.venv/bin/uvicorn portal.apps:create_app --factory \
          --host 127.0.0.1 --port @@port:apps@@ --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
