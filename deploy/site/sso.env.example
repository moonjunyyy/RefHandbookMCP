# /etc/m00nny-sso/sso.env  (0640 root:m00nny-sso)
PORTAL_REALM=M00NNY.KR
PORTAL_PRINCIPAL_FORMAT={uid}/user
# Proves the KDC is genuine on every password check: addprinc -randkey HTTP/www.m00nny.kr,
# ktadd -k /etc/m00nny-sso/http.keytab HTTP/www.m00nny.kr  (0400, owner m00nny-sso)
PORTAL_HTTP_SERVICE=HTTP@www.m00nny.kr
PORTAL_HTTP_KEYTAB=/etc/m00nny-sso/http.keytab
# Signs the browser cookie:  python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PORTAL_SSO_SECRET=
PORTAL_SSO_MAX_AGE=28800
# Token signing key:  /opt/ldap-portal/.venv/bin/python -m portal.tokens genkey /etc/m00nny-sso
# then chown m00nny-sso /etc/m00nny-sso/sso-signing.pem. Backends read sso-public.pem.
PORTAL_SSO_SIGNING_KEY_FILE=/etc/m00nny-sso/sso-signing.pem
PORTAL_SSO_ISSUER=https://www.m00nny.kr
PORTAL_SSO_AUDIENCES=account,refhandbook
PORTAL_TOKEN_TTL=60
PORTAL_DAV_PREFIX=/dav
# WebDAV clients send the password on every request; a verified one is trusted this long.
PORTAL_BASIC_CACHE_SECONDS=300
PORTAL_AUDIT_LOG=/var/log/m00nny-sso/audit.log
