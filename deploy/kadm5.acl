# Merge into /etc/krb5kdc/kadm5.acl on the KDC, ABOVE any broader rule, then restart krb5-admin-server.
# First matching line wins. UPPERCASE letters DENY that permission.
#   a=add  d=delete  m=modify  c=change password  i=inquire  l=list  s=set key  x=all
#
# 1) Things the portal must never touch, even if it is fully compromised.
portal/service@M00NNY.KR  ADMCILSP  */admin@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  krbtgt/*@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  kadmin/*@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  K/M@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  host/*@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  ldap/*@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  nfs/*@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  HTTP/*@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  portal/*@M00NNY.KR
# Single-component names that map to local accounts via auth_to_local (root@ -> root!).
portal/service@M00NNY.KR  ADMCILSP  root@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  admin@M00NNY.KR
# Existing admins' everyday principals, so a compromised portal can't take over an admin:
portal/service@M00NNY.KR  ADMCILSP  moonjunyyy/user@M00NNY.KR
portal/service@M00NNY.KR  ADMCILSP  moonjunyyy@M00NNY.KR
#
# 2) What it may do: manage ordinary "<uid>/user" principals, always under the "users" policy.
portal/service@M00NNY.KR  admci  */user@M00NNY.KR  -policy users
# add_alias creates "<uid>@M00NNY.KR". Drop this line (and set PORTAL_PRINCIPAL_ALIAS_FORMAT=)
# if you don't want aliases.
portal/service@M00NNY.KR  ai     *@M00NNY.KR
