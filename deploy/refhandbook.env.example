# /etc/refhandbook/env  (mode 0640, owner root:refhandbook)
# Remote mode settings. Start the LDAP part from:  refhandbook nslcd-env /etc/nslcd.conf

# The public origin Claude connects to (https, no path). The MCP endpoint is <this>/mcp.
RHB_PUBLIC_URL=https://hb.example.org
RHB_HOST=127.0.0.1
RHB_PORT=8765
RHB_DATA_DIR=/var/lib/refhandbook
# The kernel (0.7.0): each user's store is migrated the first time it is opened (a copy is kept as
# users/<uid>.db.pre-kernel), and the research gates come from the kernel's rules. 0 = legacy only.
#RHB_KERNEL=1

# How passwords are checked.
#   pam  (default): /etc/pam.d/refhandbook, which install.sh writes as common-auth + common-account,
#                   so sign-in works exactly like a system login (Kerberos, nslcd, sssd, ...).
#   ldap:           a simple bind as the user (RHB_LDAP_* below); needs the password in the
#                   directory, or slapd's {SASL} pass-through working for simple binds.
RHB_AUTH=pam
#RHB_PAM_SERVICE=refhandbook
# Optional: only members of this POSIX group (resolved through NSS) may sign in.
#RHB_REQUIRE_GROUP=research

# Directory, for RHB_AUTH=ldap only.
RHB_LDAP_URI=ldap://localhost
RHB_LDAP_STARTTLS=1
#RHB_LDAP_CA_FILE=/etc/ssl/certs/ldap-ca.pem
RHB_LDAP_USER_BASE=ou=people,dc=example,dc=org
RHB_LDAP_USER_FILTER=(&(objectClass=posixAccount)(uid={uid}))
# Either a DN template (skips the search) ...
#RHB_LDAP_USER_DN=uid={uid},ou=people,dc=example,dc=org
# ... or a service account for the search (anonymous search when both are unset).
#RHB_LDAP_BIND_DN=cn=nslcd,dc=example,dc=org
#RHB_LDAP_BIND_PASSWORD_FILE=/etc/refhandbook/ldap-bindpw

# Optional: only members of this group may sign in. {uid} and {dn} are filled in.
#RHB_LDAP_GROUP_BASE=ou=groups,dc=example,dc=org
#RHB_LDAP_GROUP_FILTER=(&(objectClass=posixGroup)(cn=research)(memberUid={uid}))

# Redirect URIs that clients may register (default: claude.ai, claude.com, loopback for Claude Code).
#RHB_REDIRECT_ALLOW=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:*,http://127.0.0.1:*

# Token lifetimes in seconds. A refresh re-checks the account (and the group) in the directory;
# RHB_SESSION_TTL is absolute: after it, the user signs in again whatever the refreshes.
#RHB_ACCESS_TTL=3600
#RHB_REFRESH_TTL=2592000
#RHB_SESSION_TTL=7776000

# Reverse proxies in front of this server, as addresses or CIDRs. The sign-in lockout reads the
# client address from X-Forwarded-For through these. If a router terminates TLS and forwards plain
# HTTP here, add the router's LAN address; if it forwards straight to this port, also listen on the
# LAN (RHB_HOST=0.0.0.0, or the LAN address) and firewall the port to the router.
#RHB_TRUSTED_PROXIES=127.0.0.1,::1
# Extra Host headers to accept, if the router rewrites Host (symptom: 421 on /mcp).
#RHB_ALLOWED_HOSTS=
# Refused unless StartTLS or ldaps:// is used for a non-local directory; override knowingly:
#RHB_LDAP_ALLOW_CLEARTEXT=0
