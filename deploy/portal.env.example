# /etc/ldap-portal/portal.env  (chmod 0600, owner ldap-portal)
PORTAL_SESSION_SECRET=   # python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
PORTAL_REALM=M00NNY.KR
PORTAL_LDAP_URI=ldaps://ldap.m00nny.kr
PORTAL_LDAP_CA_FILE=/etc/ldap/ca.crt
PORTAL_BASE_DN=dc=m00nny,dc=kr
PORTAL_USERS_OU=ou=Users,dc=m00nny,dc=kr
PORTAL_GROUPS_OU=ou=Groups,dc=m00nny,dc=kr
PORTAL_PRINCIPAL_FORMAT={uid}/user
PORTAL_PRINCIPAL_ALIAS_FORMAT={uid}
PORTAL_KADMIN_POLICY=users
PORTAL_SERVICE_PRINCIPAL=portal/service@M00NNY.KR
PORTAL_SERVICE_KEYTAB=/etc/ldap-portal/portal.keytab
PORTAL_HTTP_SERVICE=HTTP@portal.m00nny.kr
PORTAL_HTTP_KEYTAB=/etc/ldap-portal/http.keytab
PORTAL_DEFAULT_GROUP=user
PORTAL_ADMIN_GROUP=admin
PORTAL_HELPDESK_GROUP=helpdesk
PORTAL_PROTECTED_GROUPS=admin
PORTAL_UID_MIN=10001
PORTAL_SESSION_MAX_AGE=3600
PORTAL_AUDIT_LOG=/var/log/ldap-portal/audit.log
# Behind the site sign-in (deploy/site/): the user comes from the SSO's signed X-Auth-Token.
# local = the portal's own sign-in page.
PORTAL_AUTH=sso
PORTAL_SSO_PUBLIC_KEY_FILE=/etc/m00nny-sso/sso-public.pem
PORTAL_SSO_ISSUER=https://www.m00nny.kr
PORTAL_TOKEN_AUDIENCE=account
# Link refhandbook's approval page (same site) from the menu:
PORTAL_AGENTS_URL=/agents
PORTAL_LOGIN_URL=/auth/login
# Served under a sub-path behind nginx (see deploy/nginx.conf). Empty = at the root of its own host.
PORTAL_ROOT_PATH=/account
# Account requests ("사용 신청") at <root>/request; admins review them at <root>/admin/requests.
PORTAL_REQUESTS=1
PORTAL_REQUESTS_DB=/var/lib/ldap-portal/requests.db
PORTAL_REQUEST_TTL_DAYS=30
PORTAL_REQUEST_MAX_PENDING=100
# Shown in the consent notice as the contact for personal-data questions.
PORTAL_PRIVACY_CONTACT=관리자 admin@m00nny.kr
# gecos is readable by everyone through NSS (getent passwd); leave 0 to keep names out of it.
PORTAL_WRITE_GECOS=0
