[Unit]
Description=LDAP/Kerberos account portal
After=network-online.target

[Service]
User=ldap-portal
Group=ldap-portal
EnvironmentFile=/etc/ldap-portal/portal.env
WorkingDirectory=/opt/ldap-portal
# One worker: login throttling is kept in memory.
ExecStart=/opt/ldap-portal/.venv/bin/uvicorn portal.main:create_app --factory \
          --host 127.0.0.1 --port 8080 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/log/ldap-portal
# Pending account requests (PORTAL_REQUESTS_DB): /var/lib/ldap-portal, mode 0700.
StateDirectory=ldap-portal
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
